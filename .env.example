# Native device: use your computer's LAN address, not localhost.
# Web preview uses a same-origin /api proxy when this is omitted.
EXPO_PUBLIC_API_URL=http://192.168.0.10:8787
# Omit for native admob-test / web mock defaults. Never put live IDs here yet.
# Values: admob-test (native only), mock (web only), disabled.
# EXPO_PUBLIC_ADS_MODE=admob-test
# Explicit WEB QA fixture only; also requires a test-enabled server.
# EXPO_PUBLIC_ADS_BANNER_FIXTURE=1
# Optional own DEVELOPMENT AdMob app IDs for testing UMP messages; units stay TestIds.
# ADMOB_TEST_ANDROID_APP_ID=ca-app-pub-0000000000000000~0000000000
# ADMOB_TEST_IOS_APP_ID=ca-app-pub-0000000000000000~0000000000
