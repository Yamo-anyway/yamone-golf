{
  "expo": {
    "name": "Yamone Golf Dev",
    "slug": "yamone-golf-cloudflare-dev",
    "version": "0.3.11",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.yamone.golf.dev",
      "buildNumber": "14",
      "infoPlist": {
        "CFBundleDevelopmentRegion": "en",
        "CFBundleLocalizations": ["ko", "en"]
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundColor": "#173F34"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.yamone.golf.dev",
      "versionCode": 14,
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "name": "Yamone Golf",
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-localization",
      "expo-secure-store",
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "Use the camera to scan a personal QR.",
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": true
        }
      ],
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-3940256099942544~3347511713",
          "iosAppId": "ca-app-pub-3940256099942544~1458002511",
          "androidSdk": "nextgen",
          "delayAppMeasurementInit": true
        }
      ]
    ],
    "scheme": ["yamone-golf-dev", "yamone-golf"],
    "locales": {
      "ko": "./locales/ko.json",
      "en": "./locales/en.json"
    }
  }
}
